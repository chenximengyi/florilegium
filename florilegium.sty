%% florilegium.sty -- a procedurally generated page margin, drawn by Lua: plants, their
%% visitors and Gothic tracery, each sampled from a genome
%% https://github.com/kevinraymond/florilegium
%% Copyright (c) 2026 Kevin Raymond. MIT License, in full at the end of these notes, for
%% every file of florilegium but florilegium-pgfmath.lua, which reimplements part of pgf and
%% is under the LaTeX Project Public License 1.3c, as its header says.
%%
%% LuaLaTeX only. The geometry of every petal, leaf and stem is computed in Lua
%% (florilegium-ink.lua, florilegium-flora.lua, florilegium-native.lua) and written straight
%% into the page as PDF path operators; TeX does none of the drawing's arithmetic. A page
%% takes a few seconds.
%%
%% Usage
%%   \usepackage{florilegium}          authored composition (hand-placed, florilegium-authored.lua)
%%   \usepackage[grown]{florilegium}   composition grown to fit the page (florilegium-grow.lua),
%%                                      each main stem a plant of its own species, sampled
%%                                      from a genome (florilegium-species.lua), four to a
%%                                      page from a pool of eight per document
%%   \usepackage[nomargin]{florilegium} no margin, only \florilegiumdraw
%%   \usepackage[grown,novisitors]{florilegium}  no visitors (insects, snails, birds)
%%   \usepackage[grown,noshells]{florilegium}    no shells on the margin's ground
%%   \usepackage[grown,sections]{florilegium}    a flower beside every numbered \section
%%                                      and \subsection (standard classes)
%%   \usepackage[grown,headpieces]{florilegium}  a headpiece of Gothic tracery over every
%%                                      \section, a vine up its jamb from the margin
%%   \usepackage[grown,aging]{florilegium}       the garden ages from spring on the first
%%                                      page to autumn on the last (two runs: the page
%%                                      count is read from the .aux of the run before)
%%   \usepackage[grown,theme=geometric]{florilegium} v1.3's garden cut from flat shapes
%%                                      with straight edges (florilegium-theme-geometric.lua)
%%   \usepackage[grown,theme=math]{florilegium}  no plant: figures, symbols and equations
%%                                      cascading down the margin (florilegium-theme-math.lua)
%%   \usepackage[grown,density=0.4]{florilegium} less in the margin: 1 is full, 0.05 a
%%                                      single vine
%%   \usepackage[intensity=0.5]{florilegium}     a paler margin: 1 as painted, 0.3 faint
%%   \florilegiumbloom[motif]          (grown) a flower, or any motif of florilegium-grow.lua, in
%%                                      the margin beside the current line
%%   \florilegiumage{a}                (grown) the age of the following pages: 0 spring,
%%                                      0.5 summer, 1 autumn
%%   \florilegiumtheme{name}           the theme from the page this stands on (flora:
%%                                      none); in the preamble, for the whole document
%%   \florilegiumoff, \florilegiumon   no margin from the page this stands on, and the
%%                                      margin again; in the preamble, from the first page
%%   \florilegiumhide                  no margin on the page this stands on (in a float:
%%                                      the page the float lands on)
%%   \florilegiumhide[1,3,5-8]         no margin on those pages of the PDF, counted from 1
%%   \florilegiuminitial[lines]{L}     at the start of a paragraph: the letter L as a
%%                                      decorated initial, a tile `lines' lines tall
%%                                      (default 4), the text wrapped around it
%%   \florilegiuminitialfont{file.otf} the OpenType font the initial's outline is read
%%                                      from (default lmroman10-bold.otf)
%%   \def\florilegiumseed{7}            before \usepackage: a fixed seed (any positive
%%                                      integer) instead of the page-number seed; on the
%%                                      command line: lualatex "\def\florilegiumseed{7}\input{doc}"
%%   \florilegiumtextend               at the very end of the text (grown only): the
%%                                      garden then also fills the space below it
%%   \florilegiumframe[explain]{k}{n}  grown only: the following pages show frame k of
%%                                      n of their garden's growth (animation.tex)
%%   \definecolor{ink}{HTML}{...}       after loading: the hue of the whole palette
%%   \definecolor{accent}{HTML}{...}    the copper of the hairline accents
%%   \florilegiumornament[size=1.5em,ink=5B2A1F,angle=10,seed=random]{leaf}
%%                                      one primitive in the text, sized like a letter
%%                                      (default 1em); each one in a document differs,
%%                                      seed=random gives a new shape on every build
%%   \florilegiumdraw{flower}{1.2}      any primitive at the origin of the current TikZ
%%                                      scope; see florilegium-flora.lua for the list and options,
%%                                      e.g. \florilegiumdraw{leaf}{2.0, {depth=0.6}};
%%                                      with a theme its primitives too, e.g. {rose}{1.5}
%%
%% The garden grows in the wider side margin: in a two-sided document (twoside,
%% a wide outer margin) it changes sides with the page and is drawn mirrored.
%%
